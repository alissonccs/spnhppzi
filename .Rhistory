model_specif <- "Adj equal Gen"
#######################################################################################
# Generation of covariates and follow-up times
#######################################################################################
set.seed(5832)
cov.fu <- gencovfu(
N = N,
fu.min = fu.min,
fu.max = fu.max,
cens.prob = 0,
dist.x = c("binomial", "normal"),
par.x = list(0.7, c(0, 1)),
beta.x = c(beta1_r, beta2_r)
)
set.seed(NULL)
#######################################################################################
#Simulation of spatial zero-inflated recurrent event data
#######################################################################################
base_sp <- spsimrec2p(
N = cov.fu$N,
cov_rec = c("ID", "X1", "X2"),
beta_x_rec = c(beta1_r, beta2_r),
logist = 0,
x1 = cov.fu$x1,
fu = cov.fu$fu,
fu_max = cov.fu$fu.max,
fu_min = cov.fu$fu.min,
spatial = 1,
list_area = list_area_RMBH,
sp_model = "BYM2",
SP_N = 133,
nb_mat = Adj_matrix,
sp_tau = sp_tau_r,
sp_phi = sp_phi_r,
random_ef = 1,
pi = pi_r,
par_z = 0,
dist_int_func = "weibull",
par_int_func = c(alpha1_r, alpha2_r),
baseline = "plp"
)
#######################################################################################
# Data preparation for the joint model
# baseZ : longitudinal/logistic dataset (one row per individual)
# baseP : survival dataset (individuals with at least one event)
#######################################################################################
dat2 <- as.data.frame(base_sp) %>%
mutate(IndRec1 = case_when(
recurr == 1 ~ 0,
TRUE ~ 1
))
baseZ <- dat2[!duplicated(dat2$ID), ]
prop.table(table(baseZ$recurr))
baseP <- dat2[dat2$IndRec1 == 1, ]
# baseP <- dat2[dat2$IndRec1 == 1 & dat2$status==1, ]
baseP$timeV <- 0
#######################################################################################
# Two-part joint model fitted via INLAjoint
#######################################################################################
MTP <- joint(
formSurv = inla.surv(time = end, event = status, truncation = begin) ~
X1 + X2 + SP_ID,
dataSurv = baseP,
basRisk  = "rw2",
NbasRisk = 400,
id       = "ID",
timeVar  = "timeV",
assoc = "",
formLong = IndRec ~ 1 + (1 | ID),
family   = "binomial",
dataLong = baseZ,
run      = FALSE
)
#######################################################################################
# Specification of the spatial prior
#
# Besag (ICAR) model with a Gamma prior on the precision parameter tau
#######################################################################################
MTP$.args$formula <- update(
MTP$.args$formula,
. ~ . - SP_ID_S1 -
f(IDIntercept_L1, WIntercept_L1, model = "iid", n = 500, constr = F)+ # Remove the random iid effect.
f(
SP_ID_S1,
model = "bym2",
graph = spMat,
scale.model = TRUE,
hyper = list(
prec = list(
prior = "loggamma",
param = c(0.01, 0.01)
)
)
)
)
#######################################################################################
# Model fitting using INLA
# Fixed effects are assigned a Normal(0, 4) prior
#######################################################################################
MTP_ <- joint.run(
MTP,
class = "inla",
control.fixed = list(mean = 0, prec = 0.25)
)
#######################################################################################
# Extraction of the estimated baseline hazard (RW2)
#######################################################################################
pars_graf <- as.data.frame(tibble::tibble(
step   = 1,
t      = MTP_$summary.random$baseline1.hazard$ID,
haz    = exp(MTP_$summary.random$baseline1.hazard$mean),
N      = N,
alpha1 = alpha1_r,
alpha2 = alpha2_r,
model  = model,
model_specif = model_specif
))
#######################################################################################
# True baseline hazard (Power-law)
#######################################################################################
Bhaz <- function(t, a1, a2) a1 * a2 * t^(a2 - 1)
a1 <- alpha1_r
a2 <- alpha2_r
max_y <- ifelse(a1 == 0.5, 2, ifelse(a1 == 1, 4, 8))
#######################################################################################
# Grid for the true hazard curve
#######################################################################################
t_grid <- seq(min(pars_graf$t), max(pars_graf$t), length.out = 500)
true_df <- tibble::tibble(
t   = t_grid,
haz = Bhaz(t_grid, a1, a2)
)
#######################################################################################
# Final plot
#######################################################################################
p <- ggplot2::ggplot(
pars_graf[pars_graf$t >= 0.10, ],
ggplot2::aes(x = t, y = haz, group = step)
) +
ggplot2::geom_line(alpha = 0.2, colour = "grey1") +
ggplot2::geom_line(
data = true_df[true_df$t >= 0.10, ],
mapping = ggplot2::aes(x = t, y = haz),
inherit.aes = FALSE,
colour = "red",
linewidth = 0.7,
linetype = 2
) +
ggplot2::coord_cartesian(ylim = c(0, max_y)) +
theme_minimal(base_size = 10) +
labs(
x = "Time",
y = "Baseline hazard",
title = paste0(
"Two-part Zero-Inflated Spatial Model: RW2 vs. Power-Law | N=",
N, " | alpha1=", alpha1_r, " | alpha2=", a2
)
) +
theme(
plot.title = element_text(size = 10, hjust = 0.5)
)
p
