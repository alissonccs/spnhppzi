beta2_r  <- 0.8          # regression coefficient for X2
sp_tau_r <- 1            # spatial precision parameter
sp_phi_r <- 0.5          # Proportion of spatial variance (structured vs unstructured)
pi_r     <- 0.75         # structural zero probability (logistic part)
fu.min   <- 7            # minimum follow-up time
fu.max   <- 7            # maximum follow-up time
